# Cloud LLM (online generation). Leave CLOUD_API_KEY empty to always answer on-device.
# One key + one model name for whichever provider you want — CloudLLM (edge/llm.py) auto-detects
# the provider from the model name for these (no CLOUD_BASE_URL needed):
#   OpenAI    gpt-4o-mini, gpt-4o, ...              (also the fallback for any unrecognised name)
#   Claude    claude-opus-5, claude-sonnet-5, claude-haiku-4-5 (cheapest/fastest)
#   Gemini    gemini-... (Google AI Studio key)
#   Mistral   mistral-...
#   DeepSeek  deepseek-...
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini
# Only needed for a provider auto-detection can't identify from the model name alone — e.g. Groq or
# OpenRouter, which rehost ambiguous names like "llama-3.3-70b" that other providers also use:
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
CLOUD_BASE_URL=

# Central Qdrant Server (docker compose up -d)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edgemind_shared
# Devices go offline automatically when none of these answer a TCP connect. Empty = don't check.
INTERNET_CHECK=1.1.1.1:443,8.8.8.8:443

# Local models (Ollama)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LOCAL_LLM=qwen2.5:3b
# Used if LOCAL_LLM is not installed in Ollama
LOCAL_LLM_FALLBACK=phi3
