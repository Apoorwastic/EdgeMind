# Cloud LLM (online generation). Leave both keys empty to always answer on-device.
# Gemini is used when GEMINI_API_KEY is set (key from https://aistudio.google.com/apikey), else OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Central Qdrant Server (docker compose up -d)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edgemind_shared
# Devices go offline automatically when none of these answer a TCP connect. Empty = don't check.
INTERNET_CHECK=1.1.1.1:443,8.8.8.8:443

# Local models (Ollama)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LOCAL_LLM=qwen2.5:3b
# Used if LOCAL_LLM is not installed in Ollama
LOCAL_LLM_FALLBACK=phi3
